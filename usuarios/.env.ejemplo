# Copia este archivo como .env (o arranca una vez y se crea solo con la clave).
# Clave de cifrado de las sesiones de X: 32 bytes en base64. Si se pierde, hay que reconectar las cuentas.
X_CLAVE=
# Dónde escucha la página (por defecto solo este ordenador)
# HOST=127.0.0.1
# PUERTO=4321
# Obligatoria si HOST no es 127.0.0.1 (servidor): contraseña para entrar en la página
# USUARIOS_CLAVE=
# Cada cuántos minutos se comprueban las sesiones
# MINUTOS_COMPROBACION=30
# Si X pide esperar más de estos minutos, se avisa en vez de esperar
# ESPERA_MAX_MIN=20
# Forzar si hay pantalla para abrir la ventana de X (si|no)
# USUARIOS_PANTALLA=
